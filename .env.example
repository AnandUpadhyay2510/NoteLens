# ============================================
# CodeLens Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- OpenRouter API ---
OPENROUTER_API_KEY=API_KEY_HERE
DEFAULT_MODEL=openrouter/free

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./codelens.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codelens

# --- JWT Authentication ---
JWT_SECRET_KEY=codelens2026winner
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- Logging ---
LOG_LEVEL=INFO

# --- Application ---
APP_NAME=CodeLens
APP_VERSION=1.0.0
DEBUG=true
